# ──────────────────────────────────────────────────────────────────────────────
# application-local.properties.example
#
# TEMPLATE for local development overrides.
# Copy this file to application-local.properties and fill in your real values.
# application-local.properties is git-ignored and must NEVER be committed.
# ──────────────────────────────────────────────────────────────────────────────

# Activate this profile by passing: --spring.profiles.active=local
# Or set env var: SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:mysql://localhost:3306/vms_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Use 'update' locally so Hibernate auto-creates/alters tables during development.
# Production should use 'validate' (or Flyway/Liquibase migrations).
JPA_DDL_AUTO=update

SERVER_PORT=8080

